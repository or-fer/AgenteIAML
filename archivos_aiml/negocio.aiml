<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

<!-- Datos del negocio (ÚNICO lugar donde se editan nombres, plazos, costos y contactos). Las demás plantillas los consultan con <srai>INFO ...</srai> -->
<category><pattern>INFO TIENDA</pattern><template>Patitas pa' que las quiero</template></category>
<category><pattern>INFO SITIO</pattern><template>www.patitas.com</template></category>
<category><pattern>INFO HORARIO</pattern><template>de lunes a viernes de 9:00 a 18:00 hrs y sábados de 10:00 a 14:00 hrs</template></category>
<category><pattern>INFO COSTO ENVIO</pattern><template>$120 MXN</template></category>
<category><pattern>INFO ENVIO GRATIS MINIMO</pattern><template>$1,499 MXN</template></category>
<category><pattern>INFO PLAZO CAMBIOS</pattern><template>30 días naturales</template></category>
<category><pattern>INFO MSI PLAZOS</pattern><template>3 o 6 meses</template></category>
<category><pattern>INFO MSI MINIMO</pattern><template>$2,500 MXN</template></category>
<category><pattern>INFO VIGENCIA OXXO</pattern><template>24 horas</template></category>
<category><pattern>INFO RANGO PRECIOS</pattern><template>desde $1,199 MXN en modelos casuales básicos hasta $4,999 MXN en tenis de alta gama para competencia</template></category>
<category><pattern>INFO SHOWROOM</pattern><template>Av. Insurgentes Sur 1200, CDMX</template></category>
<category><pattern>INFO CUPON</pattern><template>SNEAKER10</template></category>
<category><pattern>INFO CORREO</pattern><template>ayuda@patitas.com</template></category>
<category><pattern>INFO PAQUETERIAS</pattern><template>DHL, Estafeta y FedEx</template></category>
<category><pattern>INFO PROCESAMIENTO</pattern><template>24 horas hábiles</template></category>
<category><pattern>INFO TIEMPO LOCAL</pattern><template>1 a 2 días hábiles</template></category>
<category><pattern>INFO TIEMPO NACIONAL</pattern><template>3 a 5 días hábiles</template></category>
<category><pattern>INFO TIEMPO EXTENDIDA</pattern><template>hasta 7 días hábiles</template></category>
<category><pattern>INFO PLAZO REEMBOLSO</pattern><template>5 a 10 días hábiles</template></category>
<category><pattern>INFO GARANTIA</pattern><template>90 días naturales</template></category>
<category><pattern>INFO VIGENCIA SPEI</pattern><template>24 horas</template></category>
</aiml>
