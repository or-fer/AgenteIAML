<category><pattern>CASI *</pattern><template><sr/></template></category>
<category><pattern>CIERTAMENTE *</pattern><template><sr/></template></category>
<category><pattern>CLARAMENTE *</pattern><template><sr/></template></category>
<category><pattern>COMPLETAMENTE *</pattern><template><sr/></template></category>
<category><pattern>DEFINITIVAMENTE *</pattern><template><sr/></template></category>
<category><pattern>DE HECHO *</pattern><template><sr/></template></category>
