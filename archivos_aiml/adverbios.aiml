<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

<!-- Adverbios y muletillas que se eliminan al inicio o al final (<sr/>). -->
<!-- Al inicio: 'realmente quiero cambiar mi talla' -> 'quiero cambiar mi talla' -->

<category><pattern>ABSOLUTAMENTE *</pattern><template><sr/></template></category>
<category><pattern>ACTUALMENTE *</pattern><template><sr/></template></category>
<category><pattern>ADEMAS *</pattern><template><sr/></template></category>
<category><pattern>AL PARECER *</pattern><template><sr/></template></category>
<category><pattern>APARENTEMENTE *</pattern><template><sr/></template></category>
