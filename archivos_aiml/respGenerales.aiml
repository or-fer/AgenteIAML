<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

<!-- Respuestas generales de conversación (confirmaciones, disculpas, 'no sé') adaptadas al dominio de atención al cliente -->

<!-- Confirmaciones: todas se reducen a CONFIRMACION -->
<category><pattern>OK</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>VALE</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>PERFECTO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>CLARO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>ENTENDIDO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>ENTIENDO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>DE ACUERDO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>LISTO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>GENIAL</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>EXCELENTE</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>BIEN</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>ASI ES</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>EXACTO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>CORRECTO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>ESTA BIEN</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>QUE BIEN</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>ME PARECE BIEN</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>SUPER</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>BUENISIMO</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>AH OK</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>ASI ESTA BIEN</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>SIN PROBLEMA</pattern><template><srai>CONFIRMACION</srai></template></category>
<category><pattern>BIEN *</pattern><template><srai><star/></srai></template></category>
<category><pattern>VALE *</pattern><template><srai><star/></srai></template></category>
<category><pattern>OK *</pattern><template><srai><star/></srai></template></category>
<category><pattern>LISTO *</pattern><template><srai><star/></srai></template></category>
<category><pattern>PERFECTO *</pattern><template><srai><star/></srai></template></category>
<category><pattern>ENTENDIDO *</pattern><template><srai><star/></srai></template></category>
<category><pattern>CLARO *</pattern><template><srai><star/></srai></template></category>
<category><pattern>VA *</pattern><template><srai><star/></srai></template></category>
<category><pattern>ORALE *</pattern><template><srai><star/></srai></template></category>
<category><pattern>SIMON *</pattern><template><srai><star/></srai></template></category>
<category><pattern>AH *</pattern><template><srai><star/></srai></template></category>
<category><pattern>AJA *</pattern><template><srai><star/></srai></template></category>
<category><pattern>BUENO *</pattern><template><srai><star/></srai></template></category>
<category><pattern>SI *</pattern><template><srai><star/></srai></template></category>
<category><pattern>JAJA *</pattern><template><srai><star/></srai></template></category>
<category><pattern>JAJAJA *</pattern><template><srai><star/></srai></template></category>
<category><pattern>JEJE *</pattern><template><srai><star/></srai></template></category>
<category><pattern>GENIAL *</pattern><template><srai><star/></srai></template></category>
<category><pattern>EXCELENTE *</pattern><template><srai><star/></srai></template></category>
<category><pattern>SUPER *</pattern><template><srai><star/></srai></template></category>
<category><pattern>CONFIRMACION</pattern><template><random><li>Perfecto. ¿Hay algo más en lo que pueda ayudarte?</li><li>Muy bien. Si tienes otra duda, dime.</li><li>De acuerdo. ¿Necesitas algo más?</li></random></template></category>

<!-- Disculpas -->
<category><pattern>LO SIENTO</pattern><template><srai>RESP DISCULPAS</srai></template></category>
<category><pattern>PERDON</pattern><template><srai>RESP DISCULPAS</srai></template></category>
<category><pattern>DISCULPA</pattern><template><srai>RESP DISCULPAS</srai></template></category>
<category><pattern>DISCULPAS</pattern><template><srai>RESP DISCULPAS</srai></template></category>
<category><pattern>PERDONA</pattern><template><srai>RESP DISCULPAS</srai></template></category>
<category><pattern>RESP DISCULPAS</pattern><template>No te preocupes. ¿En qué te puedo ayudar?</template></category>

<!-- Respuestas sueltas (sin contexto) y 'no sé' orientado al dominio -->
<category><pattern>SI</pattern><template>¿Me cuentas un poco más sobre tu consulta? Puedo ayudarte con rastreo, envíos, pagos o cambios.</template></category>
<category><pattern>NO</pattern><template>Entendido. Si necesitas algo más, aquí estaré.</template></category>
<category><pattern>NO GRACIAS</pattern><template>Entendido, gracias a ti. ¡Que tengas un excelente día!</template></category>
<category><pattern>NO SE</pattern><template><srai>ORIENTACION</srai></template></category>
<category><pattern>NO ESTOY SEGURO</pattern><template><srai>ORIENTACION</srai></template></category>
<category><pattern>NO ESTOY SEGURA</pattern><template><srai>ORIENTACION</srai></template></category>
<category><pattern>NO SE QUE PREGUNTAR</pattern><template><srai>ORIENTACION</srai></template></category>
<category><pattern>ORIENTACION</pattern><template>No te preocupes, yo te oriento. ¿Tu duda es sobre rastreo de un pedido, envíos, pagos o cambios y devoluciones?</template></category>
<category><pattern>NO ENTIENDO</pattern><template><srai>REFORMULAR</srai></template></category>
<category><pattern>NO TE ENTENDI</pattern><template><srai>REFORMULAR</srai></template></category>
<category><pattern>REPITE</pattern><template><srai>REFORMULAR</srai></template></category>
<category><pattern>NO ENTENDI</pattern><template><srai>REFORMULAR</srai></template></category>
<category><pattern>EXPLICA</pattern><template><srai>REFORMULAR</srai></template></category>
<category><pattern>EXPLICAME</pattern><template><srai>REFORMULAR</srai></template></category>
<category><pattern>REFORMULAR</pattern><template>Con gusto lo explico de otra forma. ¿Me dices qué parte no quedó clara, o cuál es tu duda: rastreo, envíos, pagos o cambios?</template></category>
<category><pattern>POR FAVOR</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>PORFA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>PORFAVOR</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>ADELANTE</pattern><template><think><set name="topic"></set></think>Claro, dime. ¿En qué te puedo ayudar?</template></category>
<category><pattern>TENGO UNA DUDA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>TENGO UNA PREGUNTA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>TENGO UN PROBLEMA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>UNA PREGUNTA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>UNA DUDA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>TENGO OTRA DUDA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>OTRA DUDA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>OTRA PREGUNTA</pattern><template><srai>ADELANTE</srai></template></category>
<category><pattern>TENGO UNA CONSULTA</pattern><template><srai>ADELANTE</srai></template></category>
</aiml>
