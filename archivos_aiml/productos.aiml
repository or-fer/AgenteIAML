<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <!-- Catálogo General -->
    <category><pattern>QUE PRODUCTOS TIENES</pattern><template><srai>CATALOGO DE PRODUCTOS</srai></template></category>
    <category><pattern>QUE VENDEN</pattern><template><srai>CATALOGO DE PRODUCTOS</srai></template></category>
    <category><pattern>VER CATALOGO</pattern><template><srai>CATALOGO DE PRODUCTOS</srai></template></category>
    
    <category>
        <pattern>CATALOGO DE PRODUCTOS</pattern>
        <template>Tenemos un gran surtido de tenis deportivos originales: Nike, Adidas, Puma, Jordan y Asics. Manejamos líneas de Running, Básquetbol, Casual y variados colores (negros, blancos, verdes, rosas, rojos).</template>
    </category>

    <!-- Manejo de Colores Específicos (Evita que se confundan con marcas) -->
    <category>
        <pattern>* TENIS VERDES</pattern>
        <template>¡Sí tenemos tenis color verde! Manejamos modelos para running y moda urbana en tonos verde olivo, menta y fosforescente.</template>
    </category>
    <category><pattern>TENIS VERDES</pattern><template><srai>UNOS TENIS VERDES</srai></template></category>
    <category><pattern>* TENIS COLOR VERDE</pattern><template><srai>UNOS TENIS VERDES</srai></template></category>

    <category>
        <pattern>* TENIS ROSAS</pattern>
        <template>¡Claro! Contamos con tenis rosas en marcas como Nike, Adidas y Puma para running y uso casual.</template>
    </category>
    <category><pattern>TENIS ROSAS</pattern><template><srai>UNOS TENIS ROSAS</srai></template></category>
    <category><pattern>* TENIS COLOR ROSA</pattern><template><srai>UNOS TENIS ROSAS</srai></template></category>
    <category><pattern>* Y ROSAS</pattern><template><srai>UNOS TENIS ROSAS</srai></template></category>

    <!-- Corrección de Typo: Runing -> Running -->
    <category><pattern>RUNING *</pattern><template><srai>TENIS DE RUNNING</srai></template></category>

    <category>
        <pattern>TENIS DE RUNNING</pattern>
        <template>Para Running te recomendamos modelos con excelente amortiguación como la saga Pegasus de Nike, Ultraboost de Adidas o Gel-Nimbus de Asics.</template>
    </category>

    <category><pattern>* RUNNING *</pattern><template><srai>TENIS DE RUNNING</srai></template></category>
    <category><pattern>DE RUNNING *</pattern><template><srai>TENIS DE RUNNING</srai></template></category>

    <!-- Marcas Generales (Evaluado solo si no es un color) -->
    <category>
        <pattern>TIENEN TENIS *</pattern>
        <template>Sí, contamos con un amplio surtido de tenis marca/estilo <star/>. ¿Buscas alguna disciplina en particular (Running, Casual, Básquetbol)?</template>
    </category>
    
    <category>
        <pattern>CATALOGO DE PRODUCTOS</pattern>
        <template>Ofrecemos calzado deportivo original de Nike, Adidas, Puma, Jordan y Asics para Running, Básquetbol, Casual y Training.</template>
    </category>

    <category><pattern>* STOCK *</pattern><template>Todos los modelos y tallas disponibles los puedes consultar en tiempo real en nuestro catálogo web.</template></category>
    <category><pattern>* DISPONIBILIDAD *</pattern><template><srai>CATALOGO DE PRODUCTOS</srai></template></category>

    <category>
        <pattern>* ULTRABOOST *</pattern>
        <template>¡Sí! Contamos con la línea Adidas Ultraboost para running con excelente amortiguación en varias tallas.</template>
    </category>
</aiml>