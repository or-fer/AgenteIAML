<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <!-- Patrón Canónico -->
    <category>
        <pattern>COMO RASTREO MI PEDIDO</pattern>
        <template>Para rastrear tu pedido necesitamos tu número de guía (ejemplo: GUIA12345 o 12345). ¿Tienes a la mano tu número de guía?</template>
    </category>

    <!-- Capturas abiertas para rastreo -->
    <category><pattern>* RASTREO *</pattern><template><srai>COMO RASTREO MI PEDIDO</srai></template></category>
    <category><pattern>* RASTREAR *</pattern><template><srai>COMO RASTREO MI PEDIDO</srai></template></category>
    <category><pattern>COMO PUEDO RASTREAR *</pattern><template><srai>COMO RASTREO MI PEDIDO</srai></template></category>

    <!-- Dónde hacer pedidos -->
    <category>
        <pattern>DONDE HAGO UN PEDIDO</pattern>
        <template>Puedes realizar tus pedidos directamente en nuestro sitio web oficial www.patitas.com o elegir tus tenis por aquí y te ayudamos a generar tu orden.</template>
    </category>

    <category><pattern>* PUEDO HACER PEDIDOS *</pattern><template><srai>DONDE HAGO UN PEDIDO</srai></template></category>
    <category><pattern>* DONDE SE HACEN * PEDIDOS *</pattern><template><srai>DONDE HAGO UN PEDIDO</srai></template></category>
    <category><pattern>* ME AYUDAS A * PEDIDO *</pattern><template><srai>DONDE HAGO UN PEDIDO</srai></template></category>

    <!-- Captura flexible de Guía -->
    <category>
        <pattern>GUIA *</pattern>
        <template>
            <set name="num_pedido"><star/></set>
            Hemos consultado la guía <get name="num_pedido"/>. Tu paquete se encuentra actualmente EN TRANSITO con entrega estimada en 24 a 48 horas.
        </template>
    </category>

    <category><pattern>MI GUIA ES *</pattern><template><srai>GUIA <star/></srai></template></category>
    <category><pattern>GUIA*</pattern><template><srai>GUIA <star/></srai></template></category>
</aiml>