<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <category><pattern>HOLA</pattern><template><srai>ATENDER SALUDO</srai></template></category>
    <category><pattern>HOLA *</pattern><template><srai>ATENDER SALUDO</srai></template></category>
    <category><pattern>BUENAS *</pattern><template><srai>ATENDER SALUDO</srai></template></category>
    <category><pattern>BUENOS DIAS *</pattern><template><srai>ATENDER SALUDO</srai></template></category>

    <category>
        <pattern>ATENDER SALUDO</pattern>
        <template>
            <condition name="usuario">
                <li value="unknown"><srai>SALUDO ANONIMO</srai></li>
                <li value=""><srai>SALUDO ANONIMO</srai></li>
                <li>¡Hola de nuevo, <get name="usuario"/>! ¿En qué te ayudamos hoy en 'Patitas pa' que las quiero'?</li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>SALUDO ANONIMO</pattern>
        <template>
            <random>
                <li>¡Hola! Bienvenido a 'Patitas pa' que las quiero'. ¿Cómo te llamas?</li>
                <li>¡Qué onda! Bienvenido a la tienda. ¿Cuál es tu nombre?</li>
            </random>
        </template>
    </category>

    <category>
        <pattern>ME LLAMO *</pattern>
        <template>
            <set name="usuario"><star/></set>, ¡un gusto atenderte! Platícame, ¿qué tenis buscas o qué trámite necesitas realizar hoy?
        </template>
    </category>

    <category><pattern>MI NOMBRE ES *</pattern><template><srai>ME LLAMO <star/></srai></template></category>
    <category><pattern>SOY *</pattern><template><srai>ME LLAMO <star/></srai></template></category>
</aiml>