<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

<!-- Normalización por reducción: elimina palabras de relleno al INICIO de la frase (preposiciones, artículos, pronombres, interrogativos, verbos de cortesía) y reprocesa el resto con <srai><star/></srai> -->

<!-- preposiciones -->
<category><pattern>A *</pattern><template><srai><star/></srai></template></category>
