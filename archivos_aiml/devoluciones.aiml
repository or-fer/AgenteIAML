<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <category>
        <pattern>CUAL ES SU POLITICA DE CAMBIOS</pattern>
        <template>
            <set name="topic">CAMBIOS</set>
            Cuentas con 30 días naturales a partir de la recepción para solicitar cambios de talla o modelo sin costo adicional. El calzado debe estar sin usar. ¿Deseas consultar REQUISITOS, INICIAR CAMBIO o SALIR?
        </template>
    </category>

    <category><pattern>* POLITICA DE CAMBIOS *</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>* POLITICA DE CAMBIOS</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>COMO ES LA POLITICA DE CAMBIOS</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>* CAMBIOS *</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>

    <topic name="CAMBIOS">
        <category>
            <pattern>REQUISITOS</pattern>
            <template>Los requisitos son: 1) Calzado sin muestras de uso, 2) Caja original en buen estado, 3) Comprobante de compra.</template>
        </category>
        <category>
            <pattern>SALIR</pattern>
            <template><set name="topic">ALL</set>Has salido del menú de cambios. ¿En qué más te puedo ayudar?</template>
        </category>
    </topic>
</aiml>