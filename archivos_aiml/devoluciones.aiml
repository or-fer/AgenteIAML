<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <category>
        <pattern>CUAL ES SU POLITICA DE CAMBIOS</pattern>
        <template>
            <set name="topic">CAMBIOS</set>
            Cuentas con 30 días naturales a partir de la recepción para solicitar cambios de talla o modelo sin costo adicional. El calzado debe estar sin usar y en su caja original. ¿Deseas saber los REQUISITOS, INICIAR CAMBIO o SALIR?
        </template>
    </category>

    <category><pattern>POLITICA DE CAMBIOS</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>* CAMBIOS *</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>* DEVOLUCION *</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>* CAMBIAR MIS TENIS *</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>ME QUEDARON CHICOS</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>
    <category><pattern>ME QUEDARON GRANDES</pattern><template><srai>CUAL ES SU POLITICA DE CAMBIOS</srai></template></category>

    <!-- Contexto por TEMA: CAMBIOS -->
    <topic name="CAMBIOS">
        <category>
            <pattern>REQUISITOS</pattern>
            <template>Los requisitos son: 1) Producto sin muestra de uso, 2) Empaque y caja original intactos, 3) Comprobante de compra o número de pedido.</template>
        </category>

        <category>
            <pattern>INICIAR CAMBIO</pattern>
            <template>Para iniciar el proceso, envía una foto de la suela de los tenis y tu número de pedido al correo cambios@tiendatenis.com para enviarte la guía prepagada de retorno.</template>
        </category>

        <category>
            <pattern>SALIR</pattern>
            <template>
                <set name="topic">ALL</set>
                Has salido de la sección de cambios. ¿En qué más te puedo asistir hoy?
            </template>
        </category>
    </topic>
</aiml>