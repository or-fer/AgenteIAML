<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <!-- Catálogo General -->
    <category>
        <pattern>CATALOGO DE PRODUCTOS</pattern>
        <template>Ofrecemos calzado deportivo original de las mejores marcas: Nike, Adidas, Puma, Jordan, New Balance y Asics. Manejamos líneas para Running, Básquetbol, Casual, Training y Fútbol.</template>
    </category>

    <category><pattern>QUE VENDEN</pattern><template><srai>CATALOGO DE PRODUCTOS</srai></template></category>
    <category><pattern>* CATALOGO *</pattern><template><srai>CATALOGO DE PRODUCTOS</srai></template></category>

    <!-- Por marcas -->
    <category>
        <pattern>TIENEN TENIS *</pattern>
        <template>Sí, contamos con un amplio surtido de tenis marca <star/>. ¿Buscas alguna disciplina en particular (Running, Casual, Básquetbol)?</template>
    </category>

    <category><pattern>TIENEN NIKE</pattern><template><srai>TIENEN TENIS NIKE</srai></template></category>
    <category><pattern>TIENEN ADIDAS</pattern><template><srai>TIENEN TENIS ADIDAS</srai></template></category>
    <category><pattern>TIENEN PUMA</pattern><template><srai>TIENEN TENIS PUMA</srai></template></category>
    <category><pattern>TIENEN JORDAN</pattern><template><srai>TIENEN TENIS JORDAN</srai></template></category>

    <!-- Por disciplinas -->
    <category>
        <pattern>TENIS DE RUNNING</pattern>
        <template>Para Running te recomendamos modelos con buena amortiguación como la saga Pegasus de Nike, Ultraboost de Adidas o Gel-Nimbus de Asics.</template>
    </category>
    <category><pattern>* RUNNING *</pattern><template><srai>TENIS DE RUNNING</srai></template></category>

    <category>
        <pattern>TENIS DE BASQUETBOL</pattern>
        <template>Para Básquetbol contamos con las líneas Jordan, Lebron, Giannis y Curry con excelente soporte de tobillo y agarre para duela o asfalto.</template>
    </category>
    <category><pattern>* BASQUETBOL *</pattern><template><srai>TENIS DE BASQUETBOL</srai></template></category>

    <!-- Guía de Tallas -->
    <category>
        <pattern>GUIA DE TALLAS</pattern>
        <template>Manejamos numeración mexicana (MX en centímetros). Si calzas del 27, corresponde a 27 cm (9 US). Te sugerimos pedir medio número más en modelos para correr.</template>
    </category>
    <category><pattern>* TALLAS *</pattern><template><srai>GUIA DE TALLAS</srai></template></category>
    <category><pattern>* NUMEROS *</pattern><template><srai>GUIA DE TALLAS</srai></template></category>
</aiml>